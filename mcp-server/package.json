{
  "name": "@iarf/pandatask-mcp-server",
  "version": "1.3.6",
  "description": "MCP server for managing Pandatask through its authenticated WordPress REST API",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "private": true,
  "bin": {
    "pandatask-mcp": "dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node --watch dist/src/index.js",
    "start": "node dist/src/index.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "audit:production": "node scripts/audit-production.mjs",
    "check": "npm run typecheck && npm test && npm run audit:production"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "marked": "^18.0.11",
    "zod": "4.4.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^7.0.2"
  }
}
