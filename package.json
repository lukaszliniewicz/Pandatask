{
  "name": "pandatask",
  "version": "1.0.16",
  "description": "Adds a shortcode [task_board board_name=\"unique_board_id\"] to display a task management board.",
  "main": "build/main.js",
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "test": "npm run test:phase2 && npm run test:gantt && npm run test:task-form && npm run test:security",
    "test:phase2": "node --test tests/phase2-contract.test.mjs",
    "test:gantt": "node --test tests/gantt-model.test.mjs",
    "test:task-form": "node --test tests/task-form-model.test.mjs",
    "test:security": "php tests/security-policy.php",
    "test:mcp": "npm --prefix mcp-server test",
    "mcp:install": "npm --prefix mcp-server ci",
    "mcp:build": "npm --prefix mcp-server run build",
    "lint": "npm run lint:js && npm run lint:style",
    "lint:js": "wp-scripts lint-js src assets/js",
    "lint:style": "wp-scripts lint-style \"assets/scss/**/*.scss\"",
    "typecheck": "tsc -p tsconfig.frontend.json",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "check:a11y": "node scripts/check-react-accessibility.mjs",
    "check:build-size": "node scripts/check-build-size.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:a11y && npm test && npm run build && npm run check:build-size && npm run audit:production",
    "zip": "npm run build && shx rm -rf release && shx mkdir -p release/pandatask/assets && shx cp pandatask.php README.txt release/pandatask/ && shx cp -r templates build src release/pandatask/ && shx cp -r assets/css assets/js release/pandatask/assets/ && cd release && bestzip ../pandatask.zip pandatask/ && cd .. && shx rm -rf release"
  },
  "author": "Lukasz Liniewicz",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=22.13",
    "npm": ">=10"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@wordpress/scripts": "^34.0.0",
    "bestzip": "^3.0.1",
    "react": "^18.3.0",
    "react-doctor": "^0.9.2",
    "react-dom": "^18.3.0",
    "sass": "^1.102.0",
    "shx": "^0.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "lucide-react": "^1.28.0",
    "react-hook-form": "^7.83.0",
    "react-mentions": "^4.4.10"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "linkify-it": "6.0.0",
    "markdown-it": "14.3.0",
    "react-mentions": {
      "@babel/runtime": "^7.29.0"
    },
    "serialize-javascript": "7.0.7",
    "uuid": "11.1.1",
    "webpack-dev-server": "6.0.0"
  }
}
