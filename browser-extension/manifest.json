{
  "manifest_version": 3,
  "name": "Pandatask Quick Capture",
  "version": "0.1.0",
  "description": "Capture the current page or selection into your Pandatask Inbox or a writable board.",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "action": {
    "default_title": "Capture to Pandatask",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
